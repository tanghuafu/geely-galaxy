+def _winpos_label(value: Any) -> tuple[str | None, str | None]:
+    """解读银河A7 VC 通道 winPos* 位置码。
+
+    银河A7 实测字段约定（与 winStatus* 配套）：
+        '0'  -> 全关到位（车窗完全关闭）
+        '8'  -> 未开 / 默认关闭（车窗处于关闭位，未收到开启指令）
+        1-7、9-99 -> 开度百分比（中间位置 = 微开/部分打开）
+        '100' -> 全开到位
+
+    返回：(展示字符串, 状态判读或 None)
+        展示字符串形如 "8(未开/默认关闭)"、"15(开度15%)"；
+        状态判读仅在能确定开/关时返回 "全关"/"微开"/"全开"，
+        用于 winStatus 缺失时的兜底。
+    """
+    if value is None:
+        return None, None
+    s = str(value).strip()
+    if s == "" or s.lower() in ("none", "null"):
+        return None, None
+    if s == "0":
+        return "0(全关到位)", "全关"
+    if s == "8":
+        return "8(未开/默认关闭)", "全关"
+    try:
+        num = int(s)
+    except (TypeError, ValueError):
+        # 非数字：原样返回，不做判读
+        return f"{s}(原始值)", None
+    if 0 < num < 95:
+        return f"{s}(开度{num}%)", "微开"
+    if num >= 95:
+        return f"{s}(开度{num}%)", "全开"
+    # 兜底
+    return f"{s}(原始值)", None
+
